@page "/error"

<PageTitle>Error</PageTitle>

<div style="display: flex; align-items: center; justify-content: center; height: calc(100vh - 100px);">
    <div style="text-align: center; max-width: 500px;">
        <div style="font-size: 48px; margin-bottom: 16px; color: #dee2e6;">!</div>
        <h2 style="color: #2c3e50; margin-bottom: 10px;">Something went wrong</h2>
        <p style="color: #6c757d; font-size: 14px; line-height: 1.6; margin-bottom: 24px;">
            An unexpected error occurred. This could be due to a network issue,
            missing data files, or a temporary service interruption.
        </p>
        <a href="/"
           style="background: #3F93B1; color: white; text-decoration: none; padding: 10px 24px;
            border-radius: 6px; font-weight: 600; font-size: 14px;">
            Return to Home
        </a>
    </div>
</div>
