@page "/"
@rendermode InteractiveServer

<PageTitle>AQ Dashboard</PageTitle>

<div style="max-width: 1200px; margin: 0 auto; padding: 20px 0;">

    <!-- Hero Section -->
    <div style="background: linear-gradient(135deg, #1a2a3a 0%, #2c4a5a 50%, #3F93B1 100%);
        border-radius: 10px; padding: 40px 50px; margin-bottom: 30px; color: white;
        display: flex; align-items: center; justify-content: space-between;">
        <div style="display: flex; align-items: center; gap: 20px;">
            <img src="images/Dash_Logo.jpg" alt="Company Logo"
                 style="max-height: 70px; max-width: 150px; border-radius: 8px; background: rgba(255,255,255,0); padding: 6px;" />
            <div>
                <h1 style="font-size: 28px; font-weight: 700; margin: 0 0 8px 0; color: white;">
                    Air Quality Analysis Dashboard
                </h1>
                <p style="font-size: 15px; color: rgba(255,255,255,0.75); margin: 0; font-weight: 400;">
                    A portfolio template for air quality data analysis for impact assessment, dispersion modelling, and monitoring insights
                </p>
            </div>
        </div>
        <div style="display: flex; align-items: center; justify-content: center; max-height: 80px; max-width: 200px;
            border-radius: 8px; background: rgba(255,255,255,0.1); padding: 6px 20px;">
            <span style="font-size: 20px; font-weight: 800; letter-spacing: 0.3px; color: white; white-space: nowrap;">AQ Dashboard</span>
        </div>
    </div>
    <!-- Quick Access Cards -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-bottom: 30px;">

        <!-- Map View Card -->
        <a href="/mapview" style="text-decoration: none;">
            <div style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 24px;
                box-shadow: 0 1px 4px rgba(0,0,0,0.06); transition: all 0.2s; cursor: pointer; height: 100%;"
                 onmouseover="this.style.boxShadow='0 4px 12px rgba(63,147,177,0.15)'; this.style.borderColor='#3F93B1';"
                 onmouseout="this.style.boxShadow='0 1px 4px rgba(0,0,0,0.06)'; this.style.borderColor='#e2e8f0';">
                <h3 style="margin: 0 0 8px 0; font-size: 18px; color: #2c3e50;">Map View</h3>
                <p style="margin: 0; font-size: 13px; color: #6c757d; line-height: 1.5;">
                    Example simulation analysis for an accidental release episode, with hourly playback and wind rose analysis.
                </p>
            </div>
        </a>

        <!-- Long Term Analysis Card -->
        <a href="/longterm-analysis" style="text-decoration: none;">
            <div style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 24px;
                box-shadow: 0 1px 4px rgba(0,0,0,0.06); transition: all 0.2s; cursor: pointer; height: 100%;"
                 onmouseover="this.style.boxShadow='0 4px 12px rgba(63,147,177,0.15)'; this.style.borderColor='#3F93B1';"
                 onmouseout="this.style.boxShadow='0 1px 4px rgba(0,0,0,0.06)'; this.style.borderColor='#e2e8f0';">
                <h3 style="margin: 0 0 8px 0; font-size: 18px; color: #2c3e50;">Long Term Analysis</h3>
                <p style="margin: 0; font-size: 13px; color: #6c757d; line-height: 1.5;">
                    A full year of historical air quality and meteorological data for Gladstone, with advanced per-pollutant diagnostics.
                </p>
            </div>
        </a>

        <!-- Air Quality Data Card -->
        <a href="/airquality" style="text-decoration: none;">
            <div style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 24px;
                box-shadow: 0 1px 4px rgba(0,0,0,0.06); transition: all 0.2s; cursor: pointer; height: 100%;"
                 onmouseover="this.style.boxShadow='0 4px 12px rgba(63,147,177,0.15)'; this.style.borderColor='#3F93B1';"
                 onmouseout="this.style.boxShadow='0 1px 4px rgba(0,0,0,0.06)'; this.style.borderColor='#e2e8f0';">
                <h3 style="margin: 0 0 8px 0; font-size: 18px; color: #2c3e50;">Live API downloads</h3>
                <p style="margin: 0; font-size: 13px; color: #6c757d; line-height: 1.5;">
                    Live meteorological and air quality readings pulled directly from Queensland Government monitoring stations.
                </p>
            </div>
        </a>

        <!-- Tools in Production Card -->
        <div style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 24px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06); opacity: 0.6;">
            <h3 style="margin: 0 0 8px 0; font-size: 18px; color: #2c3e50;">Tools in Production</h3>
            <p style="margin: 0; font-size: 13px; color: #6c757d; line-height: 1.5;">
                Additional tools including charts, reporting, and data analysis features
                are currently under development.
            </p>
            <div style="margin-top: 12px; font-size: 12px; font-weight: 600; color: #3F93B1;">Coming Soon</div>
        </div>
    </div>

    <!-- Status Section -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 30px;">

        <div style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06);">
            <div style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; color: #6c757d; font-weight: 600; margin-bottom: 6px;">
                Met Data
            </div>
            <div style="font-size: 24px; font-weight: 700; color: @(metDataAvailable ? "#28a745" : "#dc3545");">
                @(metDataAvailable ? "Available" : "Missing")
            </div>
            <div style="font-size: 12px; color: #6c757d; margin-top: 4px;">MetData.csv</div>
        </div>

        <div style="background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06);">
            <div style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; color: #6c757d; font-weight: 600; margin-bottom: 6px;">
                Server Status
            </div>
            <div style="display: flex; align-items: center; gap: 8px;">
                <div style="width: 10px; height: 10px; border-radius: 50%; background: #28a745;"></div>
                <span style="font-size: 24px; font-weight: 700; color: #28a745;">Online</span>
            </div>
            <div style="font-size: 12px; color: #6c757d; margin-top: 4px;">@DateTime.Now.ToString("dd MMM yyyy HH:mm")</div>
        </div>
    </div>

    <!-- Footer Info -->
    <div style="text-align: center; padding: 16px; color: #adb5bd; font-size: 12px;">
        AQ Dashboard — Air Quality Analysis &amp; Dispersion Modelling
    </div>

</div>

@code {
    private bool metDataAvailable = false;

    [Inject] private AQ_Dashboard.Services.AppConfig Config { get; set; } = default!;

    protected override void OnInitialized()
    {
        metDataAvailable = File.Exists(Config.MetDataPath);
    }
}
